{
  "name": "child-learn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "dev:index": "vite --mode indextts --host 0.0.0.0 --port 5173 --strictPort",
    "dev:volc": "vite --mode volcengine --host 0.0.0.0 --port 5173 --strictPort",
    "dev:flow": "vite --mode flow --host 0.0.0.0 --port 5173 --strictPort",
    "build": "npm run ui:soul:check && tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "npm run ui:soul:check && vitest run",
    "test:e2e": "playwright test",
    "lint": "npm run ui:soul:check && npm run lint:eslint && npm run lint:style && tsc --noEmit --pretty false",
    "lint:eslint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:style": "stylelint \"src/**/*.css\" --allow-empty-input",
    "ui:soul:check": "node tools/check_ui_design_soul.mjs && npm run guard:topbar",
    "guard:topbar": "node tools/check_topbar_architecture.mjs",
    "ci": "npm run ui:soul:check && npm run lint && npm run test && npm run test:e2e && npm run build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "metrics:flow": "node tools/analyze_flow_metrics.mjs",
    "voice:setup": "python3 -m pip install --no-cache-dir -r requirements-voice.txt",
    "voice:serve": "python3 tools/edge_tts_server.py",
    "voice:serve:volc": "python3 tools/volcengine_tts_server.py",
    "voice:serve:volc:lan": "VOLCENGINE_TTS_HOST=0.0.0.0 python3 tools/volcengine_tts_server.py",
    "flow:observe": "python3 tools/flow_observer_server.py",
    "voice:serve:index": "cd output/indextts2-poc/index-tts && env TOKENIZERS_PARALLELISM=false uv run python ../../../tools/indextts2_tts_server.py",
    "voice:serve:index:preload": "cd output/indextts2-poc/index-tts && env TOKENIZERS_PARALLELISM=false uv run python ../../../tools/indextts2_tts_server.py --preload"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.3",
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^25.6.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.11.3",
    "eslint": "^10.2.1",
    "jsdom": "^29.0.2",
    "playwright": "^1.59.1",
    "postcss": "^8.4.49",
    "storybook": "^8.6.14",
    "stylelint": "^17.9.0",
    "stylelint-declaration-strict-value": "^1.11.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.59.0",
    "vite": "^6.0.7",
    "vitest": "^4.1.5",
    "vitest-axe": "^0.1.0"
  }
}
