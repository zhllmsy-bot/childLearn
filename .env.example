# Copy this file to .env.local and fill values only on your machine.
# VITE_* variables are embedded into the browser bundle. Do not put secrets in them.

# Frontend runtime endpoints
VITE_TTS_URL=http://127.0.0.1:8793/synthesize
VITE_TTS_PROVIDER=volcengine
VITE_EDGE_TTS_URL=
VITE_TTS_REQUEST_TIMEOUT_MS=30000
VITE_FLOW_OBSERVER_URL=http://127.0.0.1:8792/observe
VITE_FLOW_OBSERVER_TIMEOUT_MS=30000
VITE_TELEMETRY_URL=http://127.0.0.1:8792/track
VITE_LEARNING_SYNC_URL=http://127.0.0.1:8792/sync/child-state
VITE_LEARNING_CHILD_ID=
VITE_LEARNING_SYNC_TOKEN=

# Flow Observer / local LLM bridge
FLOW_OBSERVER_HOST=127.0.0.1
FLOW_OBSERVER_PORT=8792
FLOW_OBSERVER_ALLOWED_ORIGIN=http://localhost:5173
FLOW_OBSERVER_CLIPROXY_BASE_URL=http://127.0.0.1:8317/v1
FLOW_OBSERVER_MODEL=gpt-5.4-mini
FLOW_OBSERVER_REQUEST_TIMEOUT_SECONDS=45
FLOW_OBSERVER_CLIPROXY_API_KEY=
CLIPROXY_API_KEY=
FLOW_OBSERVER_TELEMETRY_LOG=output/telemetry/childlearn-events.jsonl
FLOW_OBSERVER_SYNC_STATE_DIR=output/sync/child-state

# Edge TTS local bridge
EDGE_TTS_HOST=127.0.0.1
EDGE_TTS_PORT=8788
EDGE_TTS_CACHE_DIR=output/voice-cache

# Volcengine / Doubao TTS local bridge
VOLCENGINE_TTS_HOST=127.0.0.1
VOLCENGINE_TTS_PORT=8793
VOLCENGINE_TTS_CACHE_DIR=output/volcengine-voice-cache
VOLCENGINE_TTS_APPID=
VOLCENGINE_TTS_API_MODE=v3
VOLCENGINE_TTS_AUTH_MODE=api-key
VOLCENGINE_TTS_API_KEY=
VOLCENGINE_TTS_ACCESS_KEY=
VOLCENGINE_TTS_V3_ACCESS_KEY=
VOLCENGINE_TTS_ACCESS_TOKEN=
VOLCENGINE_TTS_SECRET_KEY=
VOLCENGINE_TTS_ENDPOINT=https://openspeech.bytedance.com/api/v3/tts/unidirectional/sse
VOLCENGINE_TTS_RESOURCE_ID=seed-tts-2.0
VOLCENGINE_TTS_CLUSTER=volcano_tts
VOLCENGINE_TTS_VOICE_TYPE=zh_female_wenrouxiaoya_moon_bigtts
VOLCENGINE_TTS_EMOTION=
VOLCENGINE_TTS_SPEED=0.95
VOLCENGINE_TTS_VOLUME=1.0
VOLCENGINE_TTS_PITCH=1.0
VOLCENGINE_TTS_SAMPLE_RATE=24000
VOLCENGINE_TTS_TIMEOUT=30

# IndexTTS2 local bridge
INDEXTTS2_HOST=127.0.0.1
INDEXTTS2_PORT=8789
INDEXTTS2_REPO_DIR=
INDEXTTS2_PROMPT=
INDEXTTS2_CACHE_DIR=output/indextts2-voice-cache
INDEXTTS2_DEVICE=
