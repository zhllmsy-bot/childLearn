{
  "plugins": ["stylelint-declaration-strict-value"],
  "rules": {
    "scale-unlimited/declaration-strict-value": [
      ["/color/", "font-size", "border-radius", "box-shadow", "font-family", "transition-duration"],
      {
        "ignoreValues": {
          "": [
            "transparent",
            "currentColor",
            "inherit",
            "none",
            "inset",
            "0",
            "0px",
            "0.01ms",
            "-1px",
            "1px",
            "2px",
            "8px",
            "12px",
            "14px",
            "16px",
            "17px",
            "18px",
            "20px",
            "22px",
            "24px",
            "28px",
            "36px",
            "48px",
            "999px",
            "50%",
            "70%"
          ],
          "box-shadow": ["/.*/"]
        }
      }
    ]
  }
}
